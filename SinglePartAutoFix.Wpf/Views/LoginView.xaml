<UserControl x:Class="SinglePartAutoFix.Wpf.Views.LoginView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource AppBackgroundBrush}"
             FontFamily="Segoe UI">
    <Grid Background="#F5F7FC">
        <Border Margin="30"
                Background="White"
                BorderBrush="#DDE3EE"
                BorderThickness="1"
                CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.07" Color="#172554"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="430"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Product identity and current Tekla context -->
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="300"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource PrimaryBrush}"
                            CornerRadius="12,0,0,0">
                        <Grid Margin="44,40,38,38">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <Border Width="32" Height="3" Background="White" CornerRadius="2" VerticalAlignment="Center"/>
                                <TextBlock Text="SINGLE PART DRAWING"
                                           Margin="12,0,0,0"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#DCE6FF"
                                           VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1"
                                       Text="Engineering&#x0a;Automation Hub"
                                       FontSize="35"
                                       FontWeight="SemiBold"
                                       LineHeight="43"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2"
                                       Text="Tekla Structures drawing operations"
                                       FontSize="12"
                                       Foreground="#DCE6FF"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Background="#F2F5FF"
                            BorderBrush="#D9E2FF"
                            BorderThickness="0,0,1,0"
                            CornerRadius="0,0,0,12">
                        <Grid Margin="44,34,38,34">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="CURRENT SESSION"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"/>

                            <Border Grid.Row="1"
                                    Margin="0,13,0,0"
                                    Padding="18"
                                    Background="White"
                                    BorderBrush="#C9D6FF"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Fill="#16A34A" VerticalAlignment="Center"/>
                                        <TextBlock Text="CONNECTED"
                                                   Margin="9,0,0,0"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="#15803D"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock x:Name="ModelNameText"
                                               Grid.Row="1"
                                               Margin="0,12,0,0"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Grid.Row="2"
                                               Text="Active Tekla model"
                                               Margin="0,5,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Grid>
                            </Border>

                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Connection verified"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="1"
                                           Text="READY"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Account access -->
                <Grid Grid.Column="1" Background="#FBFCFF">
                    <Border Width="460"
                            Padding="42,38"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="White"
                            BorderBrush="#E1E6F0"
                            BorderThickness="1"
                            CornerRadius="10">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.055" Color="#1E3A8A"/>
                        </Border.Effect>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="4"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Width="54"
                                    HorizontalAlignment="Left"
                                    Background="{StaticResource PrimaryBrush}"
                                    CornerRadius="2"/>

                            <StackPanel Grid.Row="1" Margin="0,23,0,0">
                                <TextBlock Text="SIGN IN"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource PrimaryBrush}"/>
                                <TextBlock Text="Access your workspace"
                                           Margin="0,8,0,0"
                                           FontSize="27"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                <TextBlock Text="Enter your account details to continue."
                                           Margin="0,7,0,0"
                                           FontSize="13"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>

                                <TextBlock Text="USERNAME"
                                           Margin="0,28,0,7"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#475569"/>
                                <TextBox x:Name="UsernameTextBox"
                                         Style="{StaticResource FormTextBoxStyle}"
                                         Height="44"
                                         BorderBrush="#B8C5DB"
                                         SelectionBrush="{StaticResource PrimaryBrush}"
                                         VerticalContentAlignment="Center"
                                         KeyDown="Input_KeyDown"/>

                                <TextBlock Text="PASSWORD"
                                           Margin="0,18,0,7"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="#475569"/>
                                <Grid>
                                    <PasswordBox x:Name="PasswordInput"
                                                 Style="{StaticResource FormTextBoxStyle}"
                                                 Height="44"
                                                 BorderBrush="#B8C5DB"
                                                 VerticalContentAlignment="Center"
                                                 PasswordChanged="PasswordInput_PasswordChanged"
                                                 KeyDown="Input_KeyDown"/>
                                    <TextBox x:Name="VisiblePasswordInput"
                                             Style="{StaticResource FormTextBoxStyle}"
                                             Height="44"
                                             BorderBrush="#B8C5DB"
                                             SelectionBrush="{StaticResource PrimaryBrush}"
                                             VerticalContentAlignment="Center"
                                             Visibility="Collapsed"
                                             TextChanged="VisiblePasswordInput_TextChanged"
                                             KeyDown="Input_KeyDown"/>
                                </Grid>

                                <CheckBox x:Name="ShowPasswordCheckBox"
                                          Content="Show password"
                                          Margin="0,11,0,0"
                                          FontSize="12"
                                          Foreground="{StaticResource TextSecondaryBrush}"
                                          Checked="ShowPasswordCheckBox_Changed"
                                          Unchecked="ShowPasswordCheckBox_Changed"/>

                                <Border x:Name="ErrorBorder"
                                        Margin="0,15,0,0"
                                        Padding="12,9"
                                        Background="#FEF2F2"
                                        BorderBrush="#FECACA"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Visibility="Collapsed">
                                    <TextBlock x:Name="ErrorText"
                                               FontSize="12"
                                               Foreground="{StaticResource DangerBrush}"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <Button x:Name="SignInButton"
                                        Content="Sign In"
                                        Height="45"
                                        Margin="0,21,0,0"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Click="SignInButton_Click"/>

                                <Border x:Name="DemoCredentialsBorder"
                                        Margin="0,22,0,0"
                                        Padding="14,11"
                                        Background="#F1F4FF"
                                        BorderBrush="#D9E2FF"
                                        BorderThickness="1"
                                        CornerRadius="7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Padding="8,4"
                                                Background="{StaticResource PrimaryBrush}"
                                                CornerRadius="4">
                                            <TextBlock Text="DEMO"
                                                       FontSize="9"
                                                       FontWeight="Bold"
                                                       Foreground="White"/>
                                        </Border>
                                        <TextBlock x:Name="DemoCredentialsText"
                                                   Grid.Column="1"
                                                   Margin="11,0,0,0"
                                                   FontSize="11"
                                                   Foreground="#475569"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
