<Window x:Class="SinglePartAutoFix.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Single Part Automation" Width="1200" Height="750" MinWidth="1000" MinHeight="650" WindowStartupLocation="CenterScreen">
    <Grid Margin="22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="145"/></Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel><TextBlock Text="Single Part Automation" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="Tekla Drawing Automation — Experimental WPF POC" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0"/></StackPanel>
            <StackPanel HorizontalAlignment="Right"><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Ellipse Width="9" Height="9" Margin="0,0,7,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{StaticResource ErrorBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsConnected, Mode=OneWay}" Value="True"><Setter Property="Fill" Value="{StaticResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding ConnectionText, Mode=OneWay}" FontWeight="SemiBold"/></StackPanel><TextBlock Text="{Binding ModelName, Mode=OneWay}" Foreground="{StaticResource MutedBrush}" FontSize="12" HorizontalAlignment="Right" Margin="0,3,0,0"/></StackPanel>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource SectionBorder}" Padding="14" Margin="0,0,0,12">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="1  Select Parts" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                <TextBlock Grid.Column="1" Text="2  Dry Run" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding HasPreparedCandidates, Mode=OneWay}" Value="True"><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                <TextBlock Grid.Column="2" Text="3  Review" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding DryRunComplete, Mode=OneWay}" Value="True"><Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                <TextBlock Grid.Column="3" Text="4  Generate" FontWeight="SemiBold" Foreground="{StaticResource MutedBrush}"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource SectionBorder}" Margin="0,0,0,12" Padding="14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal">
                    <StackPanel Width="120"><TextBlock Text="Selected Parts" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding SelectedPartCount, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Width="120"><TextBlock Text="Candidates" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding CandidateCount, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Width="100"><TextBlock Text="Ready" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding ReadyCount, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/></StackPanel>
                    <StackPanel Width="100"><TextBlock Text="Existing" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding ExistingCount, Mode=OneWay}" FontSize="18" FontWeight="SemiBold"/></StackPanel>
                    <StackPanel Width="110"><TextBlock Text="Need Review" Foreground="{StaticResource MutedBrush}"/><TextBlock Text="{Binding NeedReviewCount, Mode=OneWay}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource WarningBrush}"/></StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Load Selected Parts" Command="{Binding LoadCommand, Mode=OneWay}" Margin="0,0,8,0"/><Button Content="Run Dry Run" Command="{Binding DryRunCommand, Mode=OneWay}"/></StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource SectionBorder}" Padding="0" Margin="0,0,0,12">
            <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Grid Margin="14,12"><Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsBusy, Mode=OneWay}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></Grid.Style><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="180"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions><TextBlock Text="Drawing Candidates" Style="{StaticResource SectionTitle}" Margin="0" VerticalAlignment="Center"/><ComboBox Grid.Column="1" ItemsSource="{Binding StatusOptions, Mode=OneWay}" SelectedItem="{Binding SelectedStatus, Mode=TwoWay}" Margin="0,0,10,0"/><TextBox Grid.Column="2" Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" ToolTip="Search PART_POS"/></Grid>
                <DataGrid Grid.Row="1" ItemsSource="{Binding CandidatesView, Mode=OneWay}" IsReadOnly="False" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Select" Width="58"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox HorizontalAlignment="Center" IsChecked="{Binding IsSelected, Mode=TwoWay}" IsEnabled="{Binding IsEligible, Mode=OneWay}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTextColumn Header="PART_POS" Binding="{Binding PieceMark, Mode=OneWay}" Width="110" IsReadOnly="True"/><DataGridTextColumn Header="Profile" Binding="{Binding Profile, Mode=OneWay}" Width="130" IsReadOnly="True"/><DataGridTextColumn Header="Material" Binding="{Binding Material, Mode=OneWay}" Width="100" IsReadOnly="True"/><DataGridTextColumn Header="Material Type" Binding="{Binding MaterialType, Mode=OneWay}" Width="110" IsReadOnly="True"/><DataGridTextColumn Header="Qty" Binding="{Binding Quantity, Mode=OneWay}" Width="55" IsReadOnly="True"/><DataGridTextColumn Header="Numbering" Binding="{Binding Numbering, Mode=OneWay}" Width="90" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Status" Width="105"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding StatusText, Mode=OneWay}" VerticalAlignment="Center" FontWeight="SemiBold"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Style.Triggers><DataTrigger Binding="{Binding StatusText, Mode=OneWay}" Value="Ready"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/></DataTrigger><DataTrigger Binding="{Binding StatusText, Mode=OneWay}" Value="Need Review"><Setter Property="Foreground" Value="{StaticResource WarningBrush}"/></DataTrigger><DataTrigger Binding="{Binding StatusText, Mode=OneWay}" Value="Failed"><Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
                        <DataGridTextColumn Header="Validation Message" Binding="{Binding Message, Mode=OneWay}" Width="*" IsReadOnly="True"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource SectionBorder}" Padding="14" Margin="0,0,0,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="90"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Batch Limit" VerticalAlignment="Center" Margin="0,0,10,0"/><TextBox Grid.Column="1" Text="{Binding BatchLimit, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"><TextBox.Style><Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}"><Style.Triggers><DataTrigger Binding="{Binding IsBusy, Mode=OneWay}" Value="True"><Setter Property="IsEnabled" Value="False"/></DataTrigger></Style.Triggers></Style></TextBox.Style></TextBox><StackPanel Grid.Column="2" Margin="20,0" VerticalAlignment="Center"><ProgressBar Minimum="0" Maximum="{Binding ProgressMaximum, Mode=OneWay}" Value="{Binding ProgressValue, Mode=OneWay}" Height="7"/><TextBlock Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}"><Run Text="{Binding ProgressText, Mode=OneWay}"/><Run Text="  |  Current PART_POS: "/><Run Text="{Binding CurrentPieceMark, Mode=OneWay}"/></TextBlock></StackPanel><Button Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="Generate Drawings" Command="{Binding GenerateCommand, Mode=OneWay}"/></Grid></Border>

        <Grid Grid.Row="5"><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource SectionBorder}" Padding="14" Margin="0,0,12,0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="Activity / Result" Style="{StaticResource SectionTitle}"/><ListBox Grid.Row="1" ItemsSource="{Binding Activity, Mode=OneWay}" BorderThickness="0" FontFamily="Consolas" FontSize="11" ScrollViewer.VerticalScrollBarVisibility="Auto"/><TextBlock Grid.Row="1" Text="{Binding ResultSummary, Mode=OneWay}" VerticalAlignment="Bottom" Background="White" FontWeight="SemiBold" Padding="0,5,0,0"/></Grid></Border>
            <Border Grid.Column="1" Style="{StaticResource SectionBorder}" Padding="14"><StackPanel><TextBlock Text="Drawing Standardization" Style="{StaticResource SectionTitle}"/><TextBlock Text="Waiting for Engineering Standard" Foreground="{StaticResource WarningBrush}" FontWeight="SemiBold"/><TextBlock Text="Approved settings, drawing-family rules, adjustment rules, and acceptance criteria are required before development." TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,0"/><Expander Header="Technical Details" Margin="0,10,0,0" IsEnabled="{Binding HasTechnicalDetails, Mode=OneWay}"><TextBox Text="{Binding TechnicalDetails, Mode=OneWay}" IsReadOnly="True" MaxHeight="70" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></Expander></StackPanel></Border>
        </Grid>
    </Grid>
</Window>
